{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!docs", "!**/*.md"] },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "assist": { "enabled": false },
  "html": { "linter": { "enabled": false } },
  "linter": {
    "rules": {
      "complexity": { "noCommaOperator": "off", "useOptionalChain": "off" },
      "correctness": { "noUnusedFunctionParameters": "off" },
      "style": { "noDescendingSpecificity": "off", "useTemplate": "off" },
      "suspicious": { "useIterableCallbackReturn": "off" }
    }
  }
}
